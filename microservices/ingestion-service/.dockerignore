# Never ship the virtual environment — the image installs deps from scratch.
.venv/

# Build and bytecode artefacts.
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/

# Test fixtures (large PDFs) and test outputs.
tests/FM_Standard_File/
tests/__pycache__/

# Dev tooling and IDE.
.env
*.log
.kiro/

# Git history is only noise inside an image.
.git/
.gitignore
