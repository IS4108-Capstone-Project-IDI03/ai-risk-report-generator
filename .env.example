# Copy to .env and fill in real values. Never commit .env.

# ════════════════════════════════════════════════════════════════════════
#  GATEWAY (S2)
# ════════════════════════════════════════════════════════════════════════
# Used by: server. Required.
PORT=4000
JWT_SECRET=change-me
SERVICE_API_KEY=change-me-too
GATEWAY_URL=http://localhost:4000                # ingestion worker posts here; Compose overrides
APP_URL=http://localhost:3000                    # base of the emailed reset and invitation links


# ════════════════════════════════════════════════════════════════════════
#  MONGODB
# ════════════════════════════════════════════════════════════════════════
# Used by: server, ingestion worker. Required.
# Atlas: mongodb+srv://<db_username>:<db_password>@marsh-dev.rsb42ub.mongodb.net/?appName=marsh-dev
# Atlas (Backup): mongodb://<db_username>:<db_password>@ac-xbqpgyr-shard-00-00.rsb42ub.mongodb.net:27017,ac-xbqpgyr-shard-00-01.rsb42ub.mongodb.net:27017,ac-xbqpgyr-shard-00-02.rsb42ub.mongodb.net:27017/?ssl=true&replicaSet=atlas-jpotav-shard-0&authSource=admin&appName=marsh-dev
# Docker: mongodb://mongo:27017/riskreport
MONGODB_URI=


# ════════════════════════════════════════════════════════════════════════
#  REDIS (BULLMQ JOB QUEUE)
# ════════════════════════════════════════════════════════════════════════
# Used by: server, ingestion worker. Required.
REDIS_URL=redis://localhost:6379                 # Compose overrides


# ════════════════════════════════════════════════════════════════════════
#  SERVICE URLS
# ════════════════════════════════════════════════════════════════════════
# Used by: server, to reach the other services.
INGESTION_SERVICE_URL=http://ingestion-service:8001
RAG_SERVICE_URL=http://rag-service:8002
SPEECH_OCR_SERVICE_URL=http://speech-ocr-service:8003


# ════════════════════════════════════════════════════════════════════════
#  AWS S3
# ════════════════════════════════════════════════════════════════════════
# Used by: server (uploads), ingestion (downloads). EC2 uses its IAM role.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=is4108-marshriskreport-rawfiles


# ════════════════════════════════════════════════════════════════════════
#  INGESTION SERVICE: TABLE/FORMULA OCR (IN-12)
# ════════════════════════════════════════════════════════════════════════
# Used by: ingestion-service, worker.
# OCR_PROVIDER: anthropic (ANTHROPIC_API_KEY, set under RAG SERVICE) | gemini (GEMINI_API_KEY) | glm (see GLM-OCR).
OCR_PROVIDER=anthropic
OCR_MODEL=claude-haiku-5-5                       # blank = provider default
OCR_CONCURRENCY=6
OCR_RENDER_DPI=200
DOCLING_DOCUMENT_TIMEOUT=3600                    # seconds per 10-page batch; hit it and the upload fails


# ════════════════════════════════════════════════════════════════════════
#  INGESTION SERVICE: LABELLING AND DUPLICATES (IN-05, IN-07)
# ════════════════════════════════════════════════════════════════════════
# Used by: ingestion-service, worker.
TYPESAFE_API_KEY=REPLACE_ME                      # Jev classifier
OPENAI_LABEL_API_KEY=REPLACE_ME                  # real OpenAI, not the Groq OPENAI_API_KEY
LABEL_CLASSIFIER=jev                             # jev | openai-decisions | none
LABEL_LLM_PROVIDER=openai                        # openai | anthropic
LABEL_LLM_MODEL=gpt-6-luna                       # blank = provider default
LABEL_PAGES=20
LABEL_MIN_CONFIDENCE=0.70
MATCH_PASSAGE_SIMILARITY=0.90
MATCH_MIN_SHARE=0.58


# ════════════════════════════════════════════════════════════════════════
#  COHERE
# ════════════════════════════════════════════════════════════════════════
# Used by: ingestion (writes embeddings), rag-service (reads them). Same models in both.
COHERE_API_KEY=REPLACE_ME
COHERE_KEY_TIER=trial
EMBEDDING_MODEL=embed-v4.0                       # 1024 dimensions
RERANK_MODEL=rerank-v3.5


# ════════════════════════════════════════════════════════════════════════
#  CHROMA (VECTOR STORE)
# ════════════════════════════════════════════════════════════════════════
# Used by: ingestion (writes), rag-service (reads). Keep CHROMA_MODE=local for demo data.
CHROMA_MODE=cloud                                # local | cloud
CHROMA_COLLECTION=risk_chunks                    # code appends model + dimension
# Local
CHROMA_HOST=localhost                            # Compose overrides
CHROMA_PORT=8000
# Cloud (Chroma dashboard, Connect panel)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_CLOUD_HOST=api.trychroma.com


# ════════════════════════════════════════════════════════════════════════
#  RAG SERVICE (S4)
# ════════════════════════════════════════════════════════════════════════
# Used by: rag-service (GN-01). Required to draft.
# ANTHROPIC_API_KEY is also read by ingestion (OCR, labelling).
LLM_PROVIDER=anthropic                           # anthropic | gemini
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL=claude-opus-5-5                        # claude-sonnet-5-5 is cheaper for dev
LLM_EFFORT=medium                                # xhigh only if a measured comparison drafts better
CHECKLIST_EFFORT=medium                          # pre-survey checklist (CP-30), on LLM_MODEL


# ════════════════════════════════════════════════════════════════════════
#  KNOWLEDGE BASE CHAT (CB-01)
# ════════════════════════════════════════════════════════════════════════
# Used by: rag-service. Answers use CHAT_PROVIDER (anthropic | openai); defaults are the
# CB-01 model comparison's winner (docs/DECISIONS.md, 2026-10-15).
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-6.1-sol
CHAT_EFFORT=low                                  # chat does well at low effort
CHAT_PLAN_PROVIDER=anthropic                     # turns a follow-up into a search question
CHAT_PLAN_MODEL=claude-haiku-5-5
CHAT_MIN_RELEVANCE=0.2                           # below this rerank score the chat declines
OPENAI_CHAT_API_KEY=REPLACE_ME                   # real OpenAI, not the Whisper OPENAI_API_KEY


# ════════════════════════════════════════════════════════════════════════
#  SPEECH / OCR SERVICE (S5)
# ════════════════════════════════════════════════════════════════════════
# Used by: speech-ocr-service. Voice notes, site photos and handwritten note pages.
WHISPER_MODEL=whisper-1
OPENAI_API_KEY=REPLACE_ME                        # Whisper STT
GEMINI_API_KEY=REPLACE_ME                        # paid tier only
VISION_PROVIDER=gemini                           # site photos (CP-05)
VISION_MODEL=gemini-3.8-flash
# Handwritten note pages (CP-19). Blank uses VISION_PROVIDER / VISION_MODEL. No comment on
# the HANDWRITING_MODEL line itself: Docker reads a comment after an empty value as the value.
HANDWRITING_PROVIDER=gemini
HANDWRITING_MODEL=


# ════════════════════════════════════════════════════════════════════════
#  PRIVACY: CLIENT DETAILS BEFORE EXTERNAL AI CALLS (PV-01)
# ════════════════════════════════════════════════════════════════════════
# Used by: server (PII_PROTECTION), and from PV-02 on by rag, speech-ocr and
# ingestion, which ask privacy-service to swap client details for
# placeholders before text goes to an external API.
PII_PROTECTION=off                               # off | required
PRIVACY_SERVICE_URL=http://localhost:8004        # Compose overrides
PRIVACY_TIMEOUT=10                               # seconds; rag fails the draft after it (PV-02)


# ════════════════════════════════════════════════════════════════════════
#  EMAIL: PASSWORD RESET (F-06) AND INVITATIONS (F-08)
# ════════════════════════════════════════════════════════════════════════
# Used by: server. Optional. Empty SMTP_HOST prints the codes in the server console.
# Gmail: 16-character app password, no spaces. SMTP_FROM = SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ════════════════════════════════════════════════════════════════════════
#  AI COST ESTIMATES (EV-03)
# ════════════════════════════════════════════════════════════════════════
# Used by: server. Optional. Claude and Whisper prices: server/src/services/ai-pricing.service.ts
COHERE_EMBED_USD_PER_1M_TOKENS=0.12
COHERE_RERANK_USD_PER_1K_SEARCHES=2


# ════════════════════════════════════════════════════════════════════════
#  GLM-OCR VIA OLLAMA (RARE)
# ════════════════════════════════════════════════════════════════════════
# Used by: ingestion, only with docker-compose.local-ocr.yml and OCR_PROVIDER=glm.
GLMOCR_MODE=selfhosted
GLMOCR_OCR_API_HOST=localhost                    # the overlay sets `ollama`
GLMOCR_OCR_API_PORT=11434
GLMOCR_OCR_MODEL=glm-ocr:latest
# GLMOCR_OCR_REQUEST_TIMEOUT=600                 # seconds
