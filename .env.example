# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Gateway (S2) ─────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me
SERVICE_API_KEY=change-me-too
# Where the worker can reach the gateway to post notifications without keeping session alive
# localhost for a bare `python -m app.worker`; docker-compose.yml overrides it
# to the `server` service name for the ingestion-worker container.
GATEWAY_URL=http://localhost:4000

# ── Email for password reset (F-06) ──────────────────────────────────────
# Leave SMTP_HOST empty to print the reset code in the server console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<your address>, SMTP_PASS=<a Gmail
# app password, not your normal password>. Never commit real values.
# Write the 16-letter app password without spaces. Use the same Gmail address
# for SMTP_USER and SMTP_FROM (Gmail rewrites other senders). Restart the server
# after editing: a running server keeps the old values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where the browser app is served; the emailed link points here.
APP_URL=http://localhost:3000
# ── AI cost estimates (EV-03) ────────────────────────────────────────────
# Cohere publishes no per-use price; these are estimates. Claude and Whisper
# prices live in server/src/services/ai-pricing.service.ts.
COHERE_EMBED_USD_PER_1M_TOKENS=0.12
COHERE_RERANK_USD_PER_1K_SEARCHES=2

# ── MongoDB ──────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local docker-compose: mongodb://mongo:27017/riskreport
MONGODB_URI=

# ── Service URLs ─────────────────────────────────────────────────────────
INGESTION_SERVICE_URL=http://ingestion-service:8001
RAG_SERVICE_URL=http://rag-service:8002
SPEECH_OCR_SERVICE_URL=http://speech-ocr-service:8003

# ── Redis (BullMQ job queue) ───────────────────────────────────────────
# Compose overrides this to redis://redis:6379 for server and ingestion-worker.
REDIS_URL=redis://localhost:6379

# ── AWS S3 ───────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=is4108-marshriskreport-rawfiles

# ── RAG service (S4) ─────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                           # or "gemini" — swappable
ANTHROPIC_API_KEY=REPLACE_ME

# ── Automatic document labelling (IN-05) and duplicate matching (IN-07) ──
TYPESAFE_API_KEY=REPLACE_ME                      # Jev classifier (LABEL_CLASSIFIER=jev)
# Separate from OPENAI_API_KEY/OPENAI_BASE_URL below: those point at Groq (speech), never at OpenAI.
OPENAI_LABEL_API_KEY=REPLACE_ME                  # real OpenAI key: Decisions classifier / Responses LLM
LABEL_CLASSIFIER=jev                             # jev | openai-decisions | none (LLM does fixed-list too)
LABEL_LLM_PROVIDER=openai                        # openai | anthropic (free-text details; anthropic uses ANTHROPIC_API_KEY)
LABEL_LLM_MODEL=gpt-6-luna                       # blank = gpt-6-luna / claude-haiku-4-5-20251001 by provider
LABEL_PAGES=20                                   # pages read from the start of the PDF
LABEL_MIN_CONFIDENCE=0.70                        # fixed-list cutoff, from the 2026-10-07 evaluation (Jev)
MATCH_PASSAGE_SIMILARITY=0.90                    # IN-07: passages this alike (cosine) count as a match
MATCH_MIN_SHARE=0.58                             # IN-07: share of passages that must match to flag a copy, from the 2026-10-08 evaluation
LLM_MODEL=claude-opus-5-5                        # model that drafts report sections (GN-01)
LLM_EFFORT=medium                                # raise to xhigh only if a measured comparison drafts better

# ── Cohere + Chroma (shared by ingestion and RAG) ─────────────────────────
COHERE_API_KEY=REPLACE_ME
EMBEDDING_MODEL=embed-v4.0                       # both services use 1024 dimensions
RERANK_MODEL=rerank-v3.5
CHROMA_HOST=localhost                           # Compose overrides to chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=risk_chunks                   # code appends model + dimension

# ── Table/formula OCR (ingestion service, IN-12) ─────────────────────────
# Who reads cropped tables and formulas: anthropic (default, uses
# ANTHROPIC_API_KEY) | gemini (GEMINI_API_KEY) | glm (self-hosted; needs
# docker-compose.local-ocr.yml). Chosen by eval/ocr/results/2026-10-10.md.
OCR_PROVIDER=anthropic
OCR_MODEL=claude-haiku-5-5                      # blank = the provider's default
OCR_CONCURRENCY=6                               # regions read at once
OCR_RENDER_DPI=200                              # crop resolution sent to the model
DOCLING_DOCUMENT_TIMEOUT=3600                   # seconds per document; hitting it fails the upload. ~5-10 s/page on EC2

# ── GLM-OCR via Ollama (only with docker-compose.local-ocr.yml) ─────────
# The overlay points the host at its `ollama` service and sets OCR_PROVIDER=glm.
GLMOCR_MODE=selfhosted
GLMOCR_OCR_API_HOST=localhost
GLMOCR_OCR_API_PORT=11434
GLMOCR_OCR_MODEL=glm-ocr:latest

# Cloud mode: copy credentials from your team's Chroma dashboard Connect panel.
CHROMA_MODE=cloud                              # local or cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_CLOUD_HOST=api.trychroma.com             # use your database region's hostname

# ── Speech / OCR service (S5) ────────────────────────────────────────────
WHISPER_MODEL=whisper-1                          # OpenAI Whisper API model
OPENAI_API_KEY=REPLACE_ME                        # for Whisper STT
USE_CLOUD_OCR=false                              # true = AWS Textract, false = Tesseract
GEMINI_API_KEY=REPLACE_ME                        # for a gemini provider, incl. S5 photos; paid tier only
VISION_PROVIDER=gemini                           # reads site photos (CP-05); uses GEMINI_API_KEY
VISION_MODEL=gemini-3.8-flash                    # model that proposes an observation from photos
