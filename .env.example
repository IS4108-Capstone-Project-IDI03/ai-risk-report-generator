# Copy to .env and fill in real values. Never commit .env.


# ════════════════════════════════════════════════════════════════════════
#  GATEWAY (S2)
# ════════════════════════════════════════════════════════════════════════
PORT=4000
JWT_SECRET=change-me
# Sent by services as the x-service-key header.
SERVICE_API_KEY=change-me-too
# Compose overrides to the `server` service name.
GATEWAY_URL=http://localhost:4000
# Base URL of the emailed reset link.
APP_URL=http://localhost:3000


# ════════════════════════════════════════════════════════════════════════
#  EMAIL: PASSWORD RESET (F-06)
# ════════════════════════════════════════════════════════════════════════
# Empty SMTP_HOST prints the reset code in the server console.
# Gmail: app password, 16 characters, no spaces. SMTP_FROM = SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ════════════════════════════════════════════════════════════════════════
#  SERVICE URLS
# ════════════════════════════════════════════════════════════════════════
INGESTION_SERVICE_URL=http://ingestion-service:8001
RAG_SERVICE_URL=http://rag-service:8002
SPEECH_OCR_SERVICE_URL=http://speech-ocr-service:8003


# ════════════════════════════════════════════════════════════════════════
#  MONGODB
# ════════════════════════════════════════════════════════════════════════
# Atlas: mongodb+srv://<db_username>:<db_password>@marsh-dev.rsb42ub.mongodb.net/?appName=marsh-dev
# Atlas (Backup): mongodb://<db_username>:<db_password>@ac-xbqpgyr-shard-00-00.rsb42ub.mongodb.net:27017,ac-xbqpgyr-shard-00-01.rsb42ub.mongodb.net:27017,ac-xbqpgyr-shard-00-02.rsb42ub.mongodb.net:27017/?ssl=true&replicaSet=atlas-jpotav-shard-0&authSource=admin&appName=marsh-dev
# Docker: mongodb://mongo:27017/riskreport
MONGODB_URI=


# ════════════════════════════════════════════════════════════════════════
#  REDIS (BULLMQ JOB QUEUE)
# ════════════════════════════════════════════════════════════════════════
# Compose overrides to redis://redis:6379.
REDIS_URL=redis://localhost:6379


# ════════════════════════════════════════════════════════════════════════
#  AWS S3
# ════════════════════════════════════════════════════════════════════════
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=is4108-marshriskreport-rawfiles


# ════════════════════════════════════════════════════════════════════════
#  RAG SERVICE (S4)
# ════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=anthropic                           # anthropic | gemini
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL=claude-opus-5-5                        # claude-sonnet-5-5 is cheaper for dev
LLM_EFFORT=high


# ════════════════════════════════════════════════════════════════════════
#  DOCUMENT LABELLING (IN-05) AND DUPLICATE MATCHING (IN-07)
# ════════════════════════════════════════════════════════════════════════
TYPESAFE_API_KEY=REPLACE_ME                      # Jev classifier
OPENAI_LABEL_API_KEY=REPLACE_ME                  # real OpenAI, not the Groq OPENAI_API_KEY
LABEL_CLASSIFIER=jev                             # jev | openai-decisions | none
LABEL_LLM_PROVIDER=openai                        # openai | anthropic
LABEL_LLM_MODEL=gpt-6-luna                       # blank = provider default
LABEL_PAGES=20
LABEL_MIN_CONFIDENCE=0.70
MATCH_PASSAGE_SIMILARITY=0.90
MATCH_MIN_SHARE=0.58


# ════════════════════════════════════════════════════════════════════════
#  COHERE (INGESTION + RAG)
# ════════════════════════════════════════════════════════════════════════
COHERE_API_KEY=REPLACE_ME
EMBEDDING_MODEL=embed-v4.0                       # 1024 dimensions in both services
RERANK_MODEL=rerank-v3.5


# ════════════════════════════════════════════════════════════════════════
#  CHROMA (INGESTION + RAG)
# ════════════════════════════════════════════════════════════════════════
CHROMA_MODE=local                                # local | cloud
CHROMA_COLLECTION=risk_chunks                    # code appends model + dimension
# Local
CHROMA_HOST=localhost                            # Compose overrides to chroma
CHROMA_PORT=8000
# Cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_CLOUD_HOST=api.trychroma.com


# ════════════════════════════════════════════════════════════════════════
#  GLM-OCR VIA OLLAMA (INGESTION SERVICE)
# ════════════════════════════════════════════════════════════════════════
# Compose overrides the host to `ollama`.
GLMOCR_MODE=selfhosted
GLMOCR_OCR_API_HOST=localhost
GLMOCR_OCR_API_PORT=11434
GLMOCR_OCR_MODEL=glm-ocr:latest
# Seconds.
# GLMOCR_OCR_REQUEST_TIMEOUT=600


# ════════════════════════════════════════════════════════════════════════
#  HUGGING FACE CACHE (INGESTION-TEST CONTAINER)
# ════════════════════════════════════════════════════════════════════════
# HUGGINGFACE_CACHE=~/.cache/huggingface


# ════════════════════════════════════════════════════════════════════════
#  SPEECH / OCR SERVICE (S5)
# ════════════════════════════════════════════════════════════════════════
WHISPER_MODEL=whisper-1
OPENAI_API_KEY=REPLACE_ME                        # Whisper
USE_CLOUD_OCR=false                              # true = Textract, false = Tesseract
GEMINI_API_KEY=REPLACE_ME                        # paid tier only
VISION_PROVIDER=gemini                           # site photos (CP-05)
VISION_MODEL=gemini-3.8-flash


# ════════════════════════════════════════════════════════════════════════
#  AI COST ESTIMATES (EV-03)
# ════════════════════════════════════════════════════════════════════════
# Cohere has no per-use price. Claude and Whisper: server/src/services/ai-pricing.service.ts
COHERE_EMBED_USD_PER_1M_TOKENS=0.12
COHERE_RERANK_USD_PER_1K_SEARCHES=2
