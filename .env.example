# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Gateway (S2) ─────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me

# ── MongoDB ──────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local docker-compose: mongodb://mongo:27017/riskreport
MONGODB_URI=

# ── Service URLs ─────────────────────────────────────────────────────────
INGESTION_SERVICE_URL=http://ingestion-service:8001
RAG_SERVICE_URL=http://rag-service:8002
SPEECH_OCR_SERVICE_URL=http://speech-ocr-service:8003

# ── AWS S3 ───────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=is4108-marshriskreport-rawfiles

# ── RAG service (S4) ─────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                           # or "gemini" — swappable
ANTHROPIC_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME                        # only needed if provider=gemini

# ── Cohere + Chroma (shared by ingestion and RAG) ─────────────────────────
COHERE_API_KEY=REPLACE_ME
EMBEDDING_MODEL=embed-v4.0                       # both services use 1024 dimensions
RERANK_MODEL=rerank-v3.5
CHROMA_HOST=localhost                           # Compose overrides to chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=risk_chunks                   # code appends model + dimension

# ── GLM-OCR via Ollama (ingestion service) ──────────────────────────────
# Compose overrides the host to the `ollama` service name.
GLMOCR_MODE=selfhosted
GLMOCR_OCR_API_HOST=localhost
GLMOCR_OCR_API_PORT=11434
GLMOCR_OCR_MODEL=glm-ocr:latest
# Per-request timeout in seconds. Default 600 (10 min) — CPU inference on a
# full-page table crop can take several minutes. Raise if you see read timeouts.
# GLMOCR_OCR_REQUEST_TIMEOUT=600

# ── Hugging Face model cache (ingestion-test container) ─────────────────
# Path to the host HuggingFace cache directory.
# Default (~/.cache/huggingface)
# Override if your cache lives elsewhere (e.g. on a different drive).
# HUGGINGFACE_CACHE=~/.cache/huggingface

# Cloud mode: copy credentials from your team's Chroma dashboard Connect panel.
CHROMA_MODE=local                              # local or cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_CLOUD_HOST=api.trychroma.com             # use your database region's hostname

# ── Speech / OCR service (S5) ────────────────────────────────────────────
WHISPER_MODEL=whisper-1                          # OpenAI Whisper API model
OPENAI_API_KEY=REPLACE_ME                        # for Whisper STT
USE_CLOUD_OCR=false                              # true = AWS Textract, false = Tesseract
